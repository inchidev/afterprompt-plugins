{
  "description": "AfterPrompt lifecycle hooks for Codex.",
  "hooks": {
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "sh \"${PLUGIN_ROOT}/scripts/afterprompt.sh\" hook start --agent codex",
            "async": true,
            "statusMessage": "Starting the AfterPrompt timer"
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "sh \"${PLUGIN_ROOT}/scripts/afterprompt.sh\" hook stop --agent codex",
            "timeout": 10,
            "statusMessage": "Agent ready — preserving your game"
          }
        ]
      }
    ],
    "PermissionRequest": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "sh \"${PLUGIN_ROOT}/scripts/afterprompt.sh\" hook stop --agent codex",
            "timeout": 10,
            "statusMessage": "Agent ready — preserving your game"
          }
        ]
      }
    ],
    "Interrupt": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "sh \"${PLUGIN_ROOT}/scripts/afterprompt.sh\" hook stop --agent codex",
            "timeout": 3,
            "statusMessage": "Agent ready — preserving your game"
          }
        ]
      }
    ],
    "SessionEnd": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "sh \"${PLUGIN_ROOT}/scripts/afterprompt.sh\" hook stop --agent codex",
            "timeout": 3,
            "statusMessage": "Agent ready — preserving your game"
          }
        ]
      }
    ]
  }
}
